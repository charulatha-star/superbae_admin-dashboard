{
  "name": "admin-dashboard-backend",
  "version": "1.0.0",
  "description": "Express + MongoDB API replacing json-server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build && node dist/index.js\"",
    "start": "node dist/index.js",
    "seed": "npm run build && node dist/seed.js --confirm",
    "sync:test-users": "npm run build && node dist/services/triggerSync.js",
    "fix:indexes": "npm run build && node dist/scripts/fixUserIndexes.js",
    "test:overview": "npm run build && node dist/scripts/testOverview.js",
    "test:security": "npm run build && node dist/scripts/testSecurity.js",
    "test:auth": "npm run build && node dist/scripts/testAuth.js",
    "test:profile": "npm run build && node dist/scripts/testProfile.js",
    "test:anonymous-moderation": "npm run build && node dist/scripts/testAnonymousModeration.js",
    "test:event-management": "npm run build && node dist/scripts/testEventManagement.js",
    "test:event-registration": "npm run build && node dist/scripts/testEventRegistration.js",
    "test:event-checkin": "npm run build && node dist/scripts/testEventCheckin.js",
    "test:event-image-upload": "npm run build && node dist/scripts/testEventImageUpload.js",
    "test:event-analytics": "npm run build && node dist/scripts/testEventAnalytics.js",
    "test:event-reminders": "npm run build && node dist/scripts/testEventReminders.js",
    "test:event-search": "npm run build && node dist/scripts/testEventSearch.js",
    "test:content-permissions": "npm run build && node dist/scripts/testContentPermissions.js",
    "test:content-scheduler": "npm run build && node dist/scripts/testContentScheduler.js",
    "test:cms-phase3": "npm run build && node dist/scripts/testPhase3.js",
    "seed:anonymous-moderation": "npm run build && node dist/scripts/seedAnonymousModeration.js",
    "migrate:events": "npm run build && node dist/scripts/backfillEventFields.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.25",
    "@types/node-cron": "^3.0.4",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3"
  }
}
